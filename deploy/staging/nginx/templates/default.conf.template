limit_req_zone $binary_remote_addr zone=auth_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=auth_register:10m rate=3r/m;
limit_req_zone $binary_remote_addr zone=auth_password_reset:10m rate=1r/m;
limit_req_zone $binary_remote_addr zone=auth_recovery:10m rate=1r/m;
limit_conn_zone $binary_remote_addr zone=perip:10m;

server {
  listen 8080;
  return 308 https://$host$request_uri;
}

server {
  listen 8443 ssl;
  server_name ${SERVER_NAME};
  ssl_certificate /etc/nginx/conf/server.crt;
  ssl_certificate_key /etc/nginx/conf/server.key;

  client_max_body_size 16k;
  client_body_timeout 10s;
  proxy_connect_timeout 5s;
  proxy_read_timeout 30s;
  proxy_send_timeout 30s;
  limit_conn perip 40;
  limit_req_status 429;

  location = /internal/metrics {
    deny all;
  }

  location = /api/auth/login {
    limit_req zone=auth_login burst=9 nodelay;
    error_page 429 = @auth_rate_limited;
    proxy_pass http://app:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
  }

  location = /api/auth/register {
    limit_req zone=auth_register burst=2 nodelay;
    error_page 429 = @auth_rate_limited;
    proxy_pass http://app:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
  }

  # Bursts are an approximate first edge layer; the application enforces exact caps and windows.
  location = /api/auth/password-reset-request {
    limit_req zone=auth_password_reset burst=2 nodelay;
    error_page 429 = @auth_rate_limited;
    proxy_pass http://app:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
  }

  location = /api/auth/recovery {
    limit_req zone=auth_recovery burst=4 nodelay;
    error_page 429 = @auth_rate_limited;
    proxy_pass http://app:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
  }

  location @auth_rate_limited {
    internal;
    add_header Retry-After 60 always;
    return 429;
  }

  location / {
    proxy_pass http://app:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
  }
}

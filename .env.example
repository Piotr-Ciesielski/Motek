# Port lokalnego serwera aplikacji
PORT=3001

# Adres lokalny ogranicza dostęp do tego komputera
HOST=127.0.0.1

# Adres projektu z panelu Supabase, np. https://twoj-projekt.supabase.co
SUPABASE_URL=

# Klucz tylko dla backendu, typu sb_secret_...; nigdy nie dodawaj go do Git
SUPABASE_SECRET_KEY=

# Klucz publiczny przygotowany na kolejny etap: logowanie użytkowników
SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_JWKS_URL nie jest obecnie potrzebny. Dodamy konfigurację
# weryfikacji tokenów dopiero razem z konkretną implementacją logowania.

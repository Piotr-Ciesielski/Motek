# Port lokalnego serwera aplikacji
PORT=3001

# Adres lokalny ogranicza dostęp do tego komputera
HOST=127.0.0.1

# Adres projektu z panelu Supabase, np. https://twoj-projekt.supabase.co
SUPABASE_URL=

# Klucz tylko dla backendu, typu sb_secret_...; nigdy nie dodawaj go do Git
SUPABASE_SECRET_KEY=

# Klucz publiczny używany przez backend do operacji Supabase Auth użytkownika
SUPABASE_PUBLISHABLE_KEY=

# Tokeny sesji są przechowywane przez backend w ciasteczkach HttpOnly.
# Dla produkcji ustaw COOKIE_SECURE=true i udostępniaj aplikację wyłącznie przez HTTPS.
COOKIE_SECURE=false

# Publiczny origin aplikacji, np. https://motek.example.com; wymagany w produkcji dla ochrony CSRF.
APP_ORIGIN=http://127.0.0.1:3001

# Lokalne uruchomienie nie wymaga CAPTCHA ani endpointu metryk.
DEPLOYMENT_ENV=local
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
METRICS_ENABLED=false
TRUST_PROXY=false

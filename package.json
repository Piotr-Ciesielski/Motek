{
  "name": "motek",
  "version": "2.0.0-alpha.16",
  "private": true,
  "description": "Aplikacja do dopasowywania wzorów dziewiarskich do zapasu włóczek.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test --test-isolation=none",
    "check": "node --check server.js && node --check app.js && npm test",
    "patterns:check": "node --env-file-if-exists=.env scripts/import-patterns.js",
    "patterns:import": "node --env-file-if-exists=.env scripts/import-patterns.js --execute"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8"
  }
}
